# .dockerignore for the commit-image build (mayhem/Dockerfile).
# Goal: bake in the FULL repo (including .git history — the grader/PATCH tier needs it), dropping
# only local build artifacts and editor/OS cruft the autotools build regenerates anyway.

# ── autotools/make build outputs (regenerated by mayhem/build.sh) ───────────────
*.o
*.lo
*.a
*.la
/.libs/
/.deps/
Makefile
config.h
config.log
config.status
/autom4te.cache/

# ── editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
